# apps/server
PORT=8080
LOG_LEVEL=info
DEV_AUTH=1                      # accept x-dev-role / x-dev-user headers instead of Supabase JWTs
REPO=memory                     # memory | supabase
# Omit to get the whole demo network: Gandhinagar, Ahmedabad, Vadodara, Surat and Riverside.
# Set it to name your own list, comma separated; the simulator's --scenario must match.
# SCENARIO=./scenarios/gandhinagar-secretariat.json
SIM_START=2026-09-12T06:00:00Z  # simulated clock start (omit for real time)
SIM_TIME_SCALE=60               # simulated seconds per real second
SCHEDULER=lp                    # lp | greedy
FORECAST=live                   # live | synthetic
RESOLVE_INTERVAL_MIN=5
LOOKAHEAD_PERIODS=3
# Electricity Maps. Without a token, grids outside Great Britain are modelled and corrected by
# live weather; with one, their carbon intensity is measured like Britain's. Free tokens are
# granted for a single named zone — Gujarat is IN-WE — and each grid asks for its own, so set
# ELECTRICITY_MAPS_ZONE only when your token covers a different one.
ELECTRICITY_MAPS_TOKEN=
# ELECTRICITY_MAPS_ZONE=IN-WE

# Supabase (only when REPO=supabase or DEV_AUTH=0)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
# SUPABASE_DB_URL=              # only for scripts/migrate.mjs, never for the server

# Public demo (see docs/DEPLOY.md). With ACCESS_CODE_SECRET set, every seeded account has its own
# access code and every request must carry one; DEV_AUTH is ignored. OCPP_AUTH_KEY is then required.
# Print the codes with: node --env-file=.env --import tsx scripts/access-codes.ts
# ACCESS_CODE_SECRET=           # at least 24 characters; keep private, it yields every code
# OCPP_AUTH_KEY=                # at least 16 characters; the simulator reads the same variable
# TRUST_PROXY=1                 # proxies in front of the server (Render: 1); 0 when none
# CORS_ORIGINS=https://your-console.vercel.app
# SIMULATOR=off                 # scripts/start.mjs: run the server without simulated chargers
# SIM_REBASE=today              # scripts/start.mjs: replay the scenarios on today's date
# Plan this far below the grid connection, in percent, so the control loop cannot breach it
CONNECTION_MARGIN_PCT=2
